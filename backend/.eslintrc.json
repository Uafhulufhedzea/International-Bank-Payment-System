{
    "env": {
        "node": true,
        "commonjs": true,
        "es2021": true
    },
    "extends": ["eslint:recommended", "plugin:security/recommended-legacy"],
    "plugins": ["security"],
    "parserOptions": {
        "ecmaVersion": "latest"
    },
    "rules": {
        "no-eval": "error",
        "no-implied-eval": "error",
        "security/detect-object-injection": "warn",
        "security/detect-non-literal-fs-filename": "warn"
    }
}
